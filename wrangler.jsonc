{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-table-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TABLES",
        "class_name": "TableDO"
      },
      {
        "name": "GUESTS",
        "class_name": "GuestDO"
      },
      {
        "name": "OAUTH_SERIALIZER",
        "class_name": "OAuthTokenDO"
      },
      {
        "name": "ADMISSION",
        "class_name": "AdmissionDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TableDO",
        "GuestDO"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "OAuthTokenDO"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "AdmissionDO"
      ]
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "ENABLE_MCP_SUBSCRIPTIONS": "false",
    "ENABLE_OPENAI_EVENTS": "false",
    "ALLOW_NEW_GUESTS": "false",
    "ALLOW_NEW_TABLES": "true",
    "ALLOW_OUTBOUND_NOTIFICATIONS": "false"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000000"
    }
  ]
}
